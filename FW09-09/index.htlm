        <blockquote>
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quibusdam dolore illum, temporibus veritatis eligendi, aliquam,
          dolor enim itaque veniam aut eaque sequi qui quia vitae pariatur repudiandae ab dignissimos ex!
        </blockquote>

        <a href="#" class="btn btn--pill btn--accent">Lorem ipsum dolor sit</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <h4>Lorem ipsum dolor</h4>
        <ul>
          <li><a href="#">Lorem ipsum dolor sit</a></li>

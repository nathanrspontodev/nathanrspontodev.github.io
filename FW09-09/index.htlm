<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CEFET | Hi. This is CEFET.</title>
  <style> 

:root {
  --cinza-claro: rgb(244, 244, 244);
  --cinza-escuro: rgb(57, 59, 66);
  --cinza-chumbo-fonte: rgb(71, 71, 71);
  --azul-claro: rgb(118, 178, 208);
  --verde-limao: rgb(181, 211, 86);
  --rosa: rgb(196, 72, 97);
  --branco: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Segoe UI", Helvetica, Arial, sans-serif;
  color: var(--cinza-chumbo-fonte);
  line-height: 1.6;
  background: var(--branco);
}

a {
  text-decoration: none;
  color: inherit;
}

ul {
  list-style: none;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

h1, h2, h3, h4 {
  font-weight: 700;
  color: #222;
}

.btn {
  display: inline-block;
  padding: 12px 32px;
  border: 2px solid var(--branco);
  color: var(--branco);
  font-size: 0.95rem;
  transition: background-color 0.25s ease, color 0.25s ease, transform 0.15s ease;
}

.btn--pill {
  border-radius: 999px;
}

.btn:hover {
  background-color: var(--branco);
  color: var(--cinza-escuro);
  transform: translateY(-2px);
}

.btn--accent {
  border-color: var(--azul-claro);
  background-color: var(--azul-claro);
}

.btn--accent:hover {
  background-color: transparent;
  color: var(--azul-claro);
}

/*CABEÇALHO*/
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  padding: 24px 0;
}

.topbar__inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  color: var(--branco);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 1px;
}

.topnav {
  display: flex;
  gap: 32px;
}

.topnav a {
  color: var(--branco);
  font-size: 0.95rem;
  padding-bottom: 4px;
  border-bottom: 2px solid transparent;
  transition: border-color 0.2s ease;
}

.topnav a:hover {
  border-bottom-color: var(--branco);
}

.topbar .btn {
  padding: 8px 22px;
  font-size: 0.85rem;
}

.hero {
  position: relative;
  min-height: 620px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background-image: url("data:image/png;base64,"), url("data:image/jpeg;base64,");
  background-repeat: repeat, no-repeat;
  background-size: auto, cover;
  background-position: center, center;
}

.hero__content {
  max-width: 560px;
  padding: 0 24px;
}

.hero h1 {
  color: var(--branco);
  font-size: 2.75rem;
  margin-bottom: 16px;
}

.hero p {
  color: var(--cinza-claro);
  font-size: 1.05rem;
  margin-bottom: 32px;
}

/* FUNDO CINZA CLARO */
.features {
  background-color: var(--cinza-claro);
  padding: 80px 0;
  text-align: center;
}

.section-sub {
  color: #8a8a8a;
  margin: 10px auto 48px;
  max-width: 480px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.feature-card {
  background-color: var(--branco);
  padding: 40px 28px;
  border: 1px solid #e6e6e6;
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}

.feature-card:hover {
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  transform: translateY(-4px);
}

.feature-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  color: var(--branco);
  font-size: 1.4rem;
  margin-bottom: 20px;
}

.feature-icon--blue { background-color: var(--azul-claro); }
.feature-icon--green { background-color: var(--verde-limao); }
.feature-icon--pink { background-color: var(--rosa); }

.feature-icon svg {
  width: 26px;
  height: 26px;
}

.feature-card h3 {
  font-size: 1.05rem;
  margin-bottom: 12px;
}

.feature-card p {
  font-size: 0.9rem;
  color: #8a8a8a;
}

/* DEPOIMENTOS */
.testimonials {
  padding: 80px 0;
  text-align: center;
}

.people {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 40px;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
  padding: 32px 0;
  margin-bottom: 32px;
}

.person {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
}

.person img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
  background-color: #ddd;
}

.person strong {
  display: block;
  font-size: 0.9rem;
  color: #333;
}

.person span {
  display: block;
  font-size: 0.8rem;
  color: #999;
}

blockquote {
  max-width: 700px;
  margin: 0 auto 36px;
  color: #8a8a8a;
  font-size: 0.95rem;
}

/*FOOTER*/
.site-footer {
  background-color: var(--cinza-escuro);
  color: #b7b8bc;
  padding: 64px 0 24px;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  margin-bottom: 48px;
}

.footer-col h4 {
  color: var(--branco);
  font-size: 0.95rem;
  margin-bottom: 18px;
}

.footer-col li {
  margin-bottom: 10px;
}

.footer-col a {
  font-size: 0.85rem;
  transition: color 0.2s ease;
}

.footer-col a:hover {
  color: var(--branco);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 24px;
  font-size: 0.8rem;
}

.social-icons {
  display: flex;
  gap: 14px;
}

.social-icons a {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  color: #b7b8bc;
  transition: background-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
}

.social-icons a svg {
  width: 15px;
  height: 15px;
}

.social-icons a:hover {
  color: var(--branco);
}

.social-icons a:hover {
  transform: translateY(-2px);
}

.social-icons a:nth-child(1):hover { background-color: #3b5998; }
.social-icons a:nth-child(2):hover { background-color: #1da1f2; }
.social-icons a:nth-child(3):hover { background-color: var(--rosa); }
.social-icons a:nth-child(4):hover { background-color: #0077b5; }

/*Responsivo*/
@media (max-width: 700px) {
  .topnav { display: none; }
  .feature-grid { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: repeat(2, 1fr); }
  .hero h1 { font-size: 2rem; }
}

</style>
</head>
<body>

  <header class="topbar">
    <div class="topbar__inner">
      <a href="#" class="logo">CEFET</a>
      <nav class="topnav" aria-label="Navegação principal">
        <a href="#">Home</a>
        <a href="#">Generic</a>
        <a href="#">Elements</a>
      </nav>
      <a href="#" class="btn btn--pill">Sign Up</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero__content">
        <h1>Hi. This is CEFET.</h1>
        <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit.</p>
        <a href="#" class="btn btn--pill btn--accent">Lorem ipsum dolor</a>
      </div>
    </section>

    <section class="features">
      <div class="container">
        <h2>Consectetur adipisicing elit</h2>
        <p class="section-sub">Lorem ipsum dolor sit amet, delectus consequatur, similique quia!</p>

        <div class="feature-grid">
          <article class="feature-card">
            <span class="feature-icon feature-icon--blue" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
